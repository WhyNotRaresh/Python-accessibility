{
    "env": "https://example.com/",
    "path_prefix": "en",
    "resolution": "1920,1080",
    "login": {
        "continue_on_fail": false,
        "commands": [
            {
                "command": "go_to",
                "path": "/login"
            },
            {
                "command": "fill",
                "selector": "input#username",
                "value": "your-username"
            },
            {
                "command": "fill",
                "selector": "input#password",
                "value": "your-password"
            },
            {
                "command": "submit",
                "selector": "input#password"
            },
            {
                "command": "wait_for_url",
                "url": "https://example.com/"
            }
        ]
    },
    "dir": "./results",
    "remove": [],
    "commands": [
        "/",
        "/about",
        {
            "command": "go_to",
            "url": "https://example.com/page-with-tabs"
        },
        {
            "command": "click",
            "selector": "button#tab-one"
        },
        {
            "command": "run_axe"
        },
        {
            "command": "click",
            "selector": "button#tab-two"
        },
        {
            "command": "run_axe"
        }
    ]
}
